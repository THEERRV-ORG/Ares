rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function hasFinanceAccess() {
      return isMember() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.financeAccess == true;
    }

    // Every signed-in user gets their own profile doc written by the app on login.
    match /users/{uid} {
      allow read: if isMember();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Members can read their own membership doc; only managed manually in the console.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /epics/{epicId} {
      allow read, write: if isMember();

      match /discussions/{discussionId} {
        allow read, write: if isMember();
      }
    }

    match /pbis/{pbiId} {
      allow read, write: if isMember();

      match /discussions/{discussionId} {
        allow read, write: if isMember();
      }
    }

    match /tasks/{taskId} {
      allow read, write: if isMember();

      match /discussions/{discussionId} {
        allow read, write: if isMember();
      }
    }

    match /leads/{leadId} {
      allow read, write: if isMember();

      match /discussions/{discussionId} {
        allow read, write: if isMember();
      }
    }

    match /products/{productId} {
      allow read, write: if isMember();
    }

    // Anonymous by design: block any write that tries to attach an author field.
    match /retroItems/{itemId} {
      allow read: if isMember();
      allow create: if isMember() &&
        !("createdBy" in request.resource.data) &&
        !("authorEmail" in request.resource.data) &&
        !("authorName" in request.resource.data);
      allow delete: if isMember();
      allow update: if false;
    }

    match /financeMonths/{monthId} {
      allow read, write: if hasFinanceAccess();
    }

    match /incomeTargets/{targetId} {
      allow read, write: if hasFinanceAccess();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
