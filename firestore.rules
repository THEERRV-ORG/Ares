rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function hasFinanceAccess() {
      return isMember() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.financeAccess == true;
    }

    function hasWebsiteAccess() {
      return isMember() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.websiteAccess == true;
    }

    // Scoped bot account for the website contact form (/api/contact). Like the monitor bot,
    // it is NOT in /members. It can create contact submissions, and read them for the weekly
    // summary email (/api/contact/digest) — nothing else in the app.
    function isContactBot() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/contactBots/$(request.auth.uid));
    }

    function isValidContactSubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          "fullName", "company", "email", "phone", "service", "details",
          "status", "assignee", "createdAt", "updatedAt", "updatedBy", "spamReasons",
        ]) &&
        d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 100 &&
        d.company is string && d.company.size() <= 150 &&
        d.email is string && d.email.size() > 0 && d.email.size() <= 200 &&
        d.phone is string && d.phone.size() <= 30 &&
        d.service is string && d.service.size() <= 100 &&
        d.details is string && d.details.size() > 0 && d.details.size() <= 5000 &&
        d.status in ["New", "Spam"] && d.spamReasons is list && d.spamReasons.size() <= 10 &&
        d.assignee == null && d.createdAt is int &&
        d.updatedAt == null && d.updatedBy == null;
    }

    function isOnlyUpdatingSubmissionTriage() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["status", "assignee", "updatedAt", "updatedBy"]) &&
        request.resource.data.status in ["New", "Read", "Replied", "Closed", "Spam"];
    }

    // Scoped bot account for the uptime monitor. Deliberately NOT in /members — it has
    // no general access to the app, only the narrow allowances granted explicitly below.
    function isMonitorBot() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/monitorBots/$(request.auth.uid));
    }

    function isOnlyUpdatingMonitorFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          "lastCheckedAt", "lastStatus", "lastStatusCode", "lastError",
          "domainExpiryAlertedDate",
        ]);
    }

    // Console-managed only, like /members — the monitor bot's own UID lives here.
    match /monitorBots/{uid} {
      allow read, write: if false;
    }

    // Every signed-in user gets their own profile doc written by the app on login.
    match /users/{uid} {
      allow read: if isMember();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Any approved member can see the full roster (needed to filter assignee lists down to
    // real members, not everyone who's ever attempted to sign in). Managed manually in console.
    // The monitor bot is deliberately excluded — it has no reason to know who members are.
    match /members/{uid} {
      allow read: if isMember();
      allow write: if false;
    }

    match /epics/{epicId} {
      allow read, write: if isMember();

      match /discussions/{discussionId} {
        allow read, write: if isMember();
      }
    }

    match /pbis/{pbiId} {
      allow read, write: if isMember();

      match /discussions/{discussionId} {
        allow read, write: if isMember();
      }
    }

    match /tasks/{taskId} {
      allow read, write: if isMember();

      match /discussions/{discussionId} {
        allow read, write: if isMember();
      }
    }

    match /leads/{leadId} {
      allow read, write: if isMember();

      match /discussions/{discussionId} {
        allow read, write: if isMember();
      }
    }

    match /products/{productId} {
      // The bot needs to read the list to know what to check, but never create/delete products.
      allow read: if isMember() || isMonitorBot();
      allow create, delete: if isMember();
      // Regular members can edit anything; the monitor bot may only touch its own status fields.
      allow update: if isMember() || (isMonitorBot() && isOnlyUpdatingMonitorFields());

      match /checks/{checkId} {
        // The bot needs to read its own check history to find records older than the
        // retention window before it can prune them.
        allow read: if isMember() || isMonitorBot();
        allow create: if isMonitorBot();
        allow delete: if isMonitorBot();
        allow update: if false;
      }
    }

    // Anonymous by design: block any write that tries to attach an author field.
    match /retroItems/{itemId} {
      allow read: if isMember();
      allow create: if isMember() &&
        !("createdBy" in request.resource.data) &&
        !("authorEmail" in request.resource.data) &&
        !("authorName" in request.resource.data);
      allow delete: if isMember();
      allow update: if false;
    }

    // Append-only sign-in history. Anyone who signs in logs their own attempt (approved
    // member or not, same as /users) so duplicate/unapproved logins are visible; only
    // approved members can read the log, and nothing can ever be edited or removed.
    match /loginLogs/{logId} {
      allow read: if isMember();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Any member may prune entries once they're past the 30-day retention window —
      // never a recent one, no matter what triggers the delete.
      allow delete: if isMember() &&
        request.time.toMillis() - resource.data.signedInAt > 30 * 24 * 60 * 60 * 1000;
      allow update: if false;
    }

    match /contactBots/{uid} {
      allow read, write: if false;
    }

    // Website contact form messages. Contact details are personal data, so only members
    // with websiteAccess can see them; the message itself is never editable.
    match /contactSubmissions/{submissionId} {
      allow create: if isContactBot() && isValidContactSubmission();
      allow read: if hasWebsiteAccess() || isContactBot();
      allow delete: if hasWebsiteAccess();
      allow update: if hasWebsiteAccess() && isOnlyUpdatingSubmissionTriage();

      match /discussions/{discussionId} {
        allow read, write: if hasWebsiteAccess();
      }
    }

    match /financeMonths/{monthId} {
      allow read, write: if hasFinanceAccess();
    }

    match /incomeTargets/{targetId} {
      allow read, write: if hasFinanceAccess();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
